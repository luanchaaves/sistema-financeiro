# Configurações do Banco de Dados SQLite (Persistido no volume)
DATABASE_URL="file:./dev.db"

# Porta e Ambiente
PORT=3000
NODE_ENV=production

# Popular dados iniciais de demonstração na primeira inicialização (true ou false)
AUTO_SEED=true

# Metadados da Aplicação
NEXT_PUBLIC_APP_NAME="Controle Financeiro Inteligente"
NEXT_PUBLIC_APP_VERSION="1.0.0"
